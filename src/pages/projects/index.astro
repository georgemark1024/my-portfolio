---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredProjects = projects.filter((p) => p.data.featured);
const years = [...new Set(projects.map((p) => p.data.date.getFullYear()))];
---

<BaseLayout
	title={`Projects | ${SITE_TITLE}`}
	description="A showcase of things George Mark has built over the years — web apps, mobile tools, and experiments."
>
	<section>
		<h1>Projects</h1>
		<p class="muted intro">A showcase of my work and contributions across different domains.</p>
	</section>

	{
		featuredProjects.length > 0 && (
			<section class="reveal">
				<h2 class="section-title">Featured</h2>
				<div class="projects-grid">
					{featuredProjects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			</section>
		)
	}

	<section class="reveal">
		<h2 class="section-title">All Projects</h2>

		<div class="filter-bar" hidden>
			<span class="muted">Filter by year:</span>
			<button class="filter-chip" data-year="all" aria-pressed="true">All</button>
			{
				years.map((year) => (
					<button class="filter-chip" data-year={year} aria-pressed="false">
						{year}
					</button>
				))
			}
		</div>

		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>Year</th>
						<th>Project</th>
						<th>Category</th>
						<th class="tech-col">Built with</th>
						<th>Links</th>
					</tr>
				</thead>
				<tbody>
					{
						projects.map((project) => (
							<tr data-year={project.data.date.getFullYear()}>
								<td class="year">{project.data.date.getFullYear()}</td>
								<td class="name">
									<a href={`/projects/${project.id}/`}>{project.data.title}</a>
								</td>
								<td class="muted">{project.data.category}</td>
								<td class="tech-col">
									<div class="tag-row">
										{project.data.technologies.map((tech) => (
											<span class="tag">{tech}</span>
										))}
									</div>
								</td>
								<td class="links">
									{project.data.link && (
										<a
											href={project.data.link}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`${project.data.title} — external link`}
										>
											<svg
												viewBox="0 0 24 24"
												aria-hidden="true"
												width="18"
												height="18"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
												<path d="M15 3h6v6" />
												<path d="M10 14 21 3" />
											</svg>
										</a>
									)}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		margin-bottom: 3rem;
	}

	section {
		margin-bottom: 3rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.filter-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}

	.filter-bar[hidden] {
		display: none;
	}

	.filter-chip {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text);
		padding: 0.3rem 0.9rem;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.filter-chip:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.filter-chip[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-contrast);
	}

	.table-wrap {
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	th {
		text-align: left;
		padding: 0.75rem 1rem;
		border-bottom: 2px solid var(--border);
		color: var(--text-muted);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
	}

	td {
		padding: 0.9rem 1rem;
		border-bottom: 1px solid var(--border);
		vertical-align: top;
	}

	.year {
		color: var(--text-muted);
		white-space: nowrap;
	}

	.name a {
		font-weight: 600;
	}

	.links a {
		color: var(--text-muted);
		display: inline-flex;
	}

	.links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.tech-col {
			display: none;
		}
	}
</style>

<script>
	const filterBar = document.querySelector<HTMLElement>('.filter-bar');
	if (filterBar) {
		filterBar.hidden = false;
		const chips = filterBar.querySelectorAll<HTMLButtonElement>('.filter-chip');
		const rows = document.querySelectorAll<HTMLTableRowElement>('tbody tr[data-year]');
		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				const year = chip.dataset.year;
				rows.forEach((row) => {
					row.hidden = year !== 'all' && row.dataset.year !== year;
				});
			});
		});
	}
</script>
