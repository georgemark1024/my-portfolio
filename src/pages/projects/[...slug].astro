---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
	title={`${project.data.title} | ${SITE_TITLE}`}
	description={project.data.description}
	image={project.data.image}
>
	<a href="/projects/" class="view-all back-link">← Back to Projects</a>

	<article class="project-header">
		<h1>{project.data.title}</h1>
		<p class="muted description">{project.data.description}</p>

		<div class="project-meta">
			<div class="project-meta-item">
				<span class="eyebrow">Category</span>
				<span class="project-meta-value">{project.data.category}</span>
			</div>
			<div class="project-meta-item">
				<span class="eyebrow">Date</span>
				<span class="project-meta-value">
					{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
				</span>
			</div>
			<div class="project-meta-item">
				<span class="eyebrow">Technologies</span>
				<div class="tag-row">
					{project.data.technologies.map((tech) => <span class="tag">{tech}</span>)}
				</div>
			</div>
		</div>

		{
			project.data.link && (
				<div class="project-links">
					<a href={project.data.link} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
						View Live Project →
					</a>
				</div>
			)
		}
	</article>

	<article class="content">
		<Content />
	</article>
</BaseLayout>

<style>
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.description {
		font-size: 1.1rem;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		margin: 2rem 0;
		align-items: flex-start;
	}

	.project-meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.project-meta-item .eyebrow {
		margin-bottom: 0;
	}

	.project-meta-value {
		font-weight: 600;
	}

	.project-links {
		display: flex;
		gap: 1rem;
		margin: 2rem 0;
		flex-wrap: wrap;
	}

	.content {
		margin: 3rem 0;
		line-height: 1.8;
		max-width: 760px;
	}

	.content :global(h2) {
		margin-top: 2rem;
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--border);
	}

	.content :global(h3) {
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}

	@media (max-width: 768px) {
		.project-meta {
			flex-direction: column;
			gap: 1.5rem;
		}
	}
</style>
