---
import BaseLayout from './../layouts/BaseLayout.astro';
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
---

<BaseLayout
	title={`About | ${SITE_TITLE}`}
	description="About George Mark — a developer of data systems that help organisations make informed decisions, studying Computer Science at the University of Nairobi."
>
	<div class="prose">
		<h1>About Me</h1>
		<p>
			I develop data systems -- pipelines, warehouses, and the services around them -- that help
			organisations make informed decisions and achieve their targets.
		</p>
		<p>
			I want to build tools and systems that solve problems for my community. I believe
			technology has the power to transform lives in meaningful and impactful ways and I want to be
			at the forefront of that transformation.
		</p>
		<p>
			If you have a project you think I'd enjoy, an idea worth kicking around, or
			a team you think I'd fit into, I'd genuinely like to hear from you. The
			<a href="/contact">contact page</a> has all the ways to reach me; email
			<a href={`mailto:${CONTACT_EMAIL}`}>gets seen fastest</a>.
		</p>
		<p>-GM</p>
	</div>
</BaseLayout>
