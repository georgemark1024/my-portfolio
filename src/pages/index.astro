---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait.jpg';
import ProjectCard from '../components/ProjectCard.astro';
import PostPreview from '../components/PostPreview.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { skillGroups } from '../data/skills';
import { SITE_DESCRIPTION, SITE_TITLE, CONTACT_EMAIL } from '../consts';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-text">
			<p class="eyebrow">Hi, I'm</p>
			<h1>George Mark</h1>
			<p class="tagline">
				I build practical web and mobile tools — currently studying Computer Science at the
				University of Nairobi. I enjoy solving problems and understanding the why behind things.
			</p>
			<div class="cta-buttons">
				<a href="/projects" class="btn btn-primary">View my work</a>
				<a href="/#contact" class="btn btn-secondary">Get in touch</a>
			</div>
		</div>
		<div class="hero-photo">
			<Image src={portrait} alt="Portrait of George Mark" width={400} height={500} loading="eager" />
		</div>
	</section>

	<section class="reveal">
		<h2 class="section-title">Skills</h2>
		<div class="skills-grid">
			{
				skillGroups.map((group) => (
					<div class="skill-group">
						<h3>{group.label}</h3>
						<div class="tag-row">
							{group.items.map((item) => (
								<span class="tag">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="reveal">
		<h2 class="section-title">Experience</h2>
		<ExperienceTimeline />
	</section>

	{
		projects.length > 0 && (
			<section class="reveal">
				<h2 class="section-title">Featured Projects</h2>
				<div class="projects-grid">
					{projects.map((project) => (
						<ProjectCard project={project} maxTags={3} />
					))}
				</div>
				<a href="/projects" class="view-all">
					View all projects →
				</a>
			</section>
		)
	}

	{
		recentPosts.length > 0 && (
			<section class="reveal">
				<h2 class="section-title">Latest Articles</h2>
				<div class="posts-list">
					{recentPosts.map((post) => (
						<PostPreview post={post} />
					))}
				</div>
				<a href="/blog" class="view-all">
					View all articles →
				</a>
			</section>
		)
	}

	<section id="contact" class="reveal contact">
		<h2 class="section-title">Get In Touch</h2>
		<p class="muted">
			Have a project in mind, a question, or just want to say hi? My inbox is always open.
		</p>
		<a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-primary">Say hello</a>
	</section>
</BaseLayout>

<style>
	section {
		margin-bottom: 4rem;
	}

	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: 3rem 0 2rem 0;
	}

	.hero-text {
		max-width: 620px;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.hero .eyebrow {
		margin-bottom: 0.25rem;
	}

	.hero-photo {
		flex-shrink: 0;
	}

	.hero-photo :global(img) {
		display: block;
		width: min(340px, 100%);
		height: auto;
		border-radius: 16px;
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
	}

	.tagline {
		font-size: 1.125rem;
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 2rem;
	}

	.skill-group h3 {
		margin-bottom: 0.75rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.875rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.posts-list {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.contact p {
		max-width: 540px;
	}

	@media (max-width: 768px) {
		.hero {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 2rem;
			padding-top: 2rem;
		}

		.hero h1 {
			font-size: 2.25rem;
		}

		.hero-photo :global(img) {
			width: min(280px, 100%);
		}
	}
</style>
