---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, CONTACT_EMAIL, SOCIAL_LINKS } from '../consts';
---

<BaseLayout
	title={`Contact | ${SITE_TITLE}`}
	description="Get in touch with George Mark — email is fastest, or reach out on LinkedIn or X."
>
	<section>
		<h1>Get In Touch</h1>
		<p class="muted intro">
			Have a project in mind, a question, or just want to say hi? My inbox is always open — email
			is the fastest way to reach me.
		</p>
	</section>

	<ul class="channels reveal">
		<li>
			<a class="channel" href={`mailto:${CONTACT_EMAIL}`}>
				<span class="channel-icon">
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						width="22"
						height="22"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
				</span>
				<span class="channel-text">
					<span class="channel-label">Email</span>
					<span class="channel-value">{CONTACT_EMAIL}</span>
				</span>
			</a>
		</li>
		<li>
			<a class="channel" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">
				<span class="channel-icon">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
						><path
							fill="currentColor"
							d="M13.6915026,13.7657972 L11.2274352,13.7657972 L11.2274352,10.1012325 C11.2274352,9.14905363 10.3918652,8.38565022 9.31830986,8.38565022 C8.24475451,8.38565022 7.40918453,9.14905363 7.40918453,10.1012325 L7.40918453,13.7657972 L4.94511722,13.7657972 L4.94511722,5.14607715 L7.40918453,5.14607715 L7.40918453,6.5581278 C7.81472327,5.81956589 8.81815034,5.09624505 10.4944568,5.09624505 C12.9585242,5.09624505 13.6915026,6.66926407 13.6915026,8.96518017 L13.6915026,13.7657972 Z M2.37371134,4.26115223 C1.64660142,4.26115223 1.05880758,3.6724395 1.05880758,2.94532957 C1.05880758,2.21821963 1.64660142,1.62942629 2.37371134,1.62942629 C3.10082126,1.62942629 3.6886151,2.21821963 3.6886151,2.94532957 C3.6886151,3.6724395 3.10082126,4.26115223 2.37371134,4.26115223 Z M3.44665735,13.7657972 L1.30076534,13.7657972 L1.30076534,5.14607715 L3.44665735,5.14607715 L3.44665735,13.7657972 Z M14.915026,0 L1.08497342,0 C0.486979338,0 0,0.474332711 0,1.05880758 L0,14.9411924 C0,15.5266572 0.486979338,16 1.08497342,16 L14.915026,16 C15.5130206,16 16,15.5266572 16,14.9411924 L16,1.05880758 C16,0.474332711 15.5130206,0 14.915026,0 Z"
						></path></svg
					>
				</span>
				<span class="channel-text">
					<span class="channel-label">LinkedIn</span>
					<span class="channel-value">georgemarkokumu</span>
				</span>
			</a>
		</li>
		<li>
			<a class="channel" href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer">
				<span class="channel-icon">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
						><path
							fill="currentColor"
							d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
						></path></svg
					>
				</span>
				<span class="channel-text">
					<span class="channel-label">X</span>
					<span class="channel-value">@_okumuu</span>
				</span>
			</a>
		</li>
	</ul>
</BaseLayout>

<style>
	.intro {
		max-width: 540px;
		margin-bottom: 3rem;
	}

	.channels {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		max-width: 480px;
	}

	.channels li {
		margin: 0;
	}

	.channel {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--card-bg);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.channel:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow);
		text-decoration: none;
		color: inherit;
	}

	.channel-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		border-radius: 50%;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--accent);
		transition:
			transform 0.2s ease,
			background-color 0.2s ease;
	}

	.channel:hover .channel-icon {
		transform: scale(1.1);
		background: var(--accent-subtle);
	}

	.channel-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.channel-label {
		font-weight: 600;
	}

	.channel-value {
		color: var(--text-muted);
		font-size: 0.9375rem;
		overflow-wrap: anywhere;
	}

	@media (prefers-reduced-motion: reduce) {
		.channel-icon,
		.channel:hover .channel-icon {
			transition: none;
			transform: none;
		}
	}
</style>
