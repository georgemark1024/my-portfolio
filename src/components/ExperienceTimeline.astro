---
import { experience } from '../data/experience';

function formatMonth(value?: string): string {
	if (!value) return 'Present';
	const [year, month] = value.split('-').map(Number);
	return new Date(year, (month ?? 1) - 1).toLocaleDateString('en-US', {
		month: 'short',
		year: 'numeric',
	});
}
---

<ol class="timeline">
	{
		experience.map((entry) => (
			<li>
				<p class="period muted">
					{formatMonth(entry.start)} — {formatMonth(entry.end)}
				</p>
				<h3>
					{entry.role}
					<span class="org">
						·{' '}
						{entry.orgUrl ? (
							<a href={entry.orgUrl} target="_blank" rel="noopener noreferrer">
								{entry.org}
							</a>
						) : (
							entry.org
						)}
					</span>
				</h3>
				<p class="summary">{entry.summary}</p>
				{entry.highlights && (
					<ul>
						{entry.highlights.map((highlight) => (
							<li>{highlight}</li>
						))}
					</ul>
				)}
				{entry.tech && (
					<div class="tag-row">
						{entry.tech.map((tech) => (
							<span class="tag">{tech}</span>
						))}
					</div>
				)}
			</li>
		))
	}
</ol>

<style>
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.timeline > li {
		position: relative;
		padding: 0 0 2rem 1.75rem;
		border-left: 2px solid var(--border);
		margin: 0;
	}

	.timeline > li:last-child {
		padding-bottom: 0.5rem;
	}

	.timeline > li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 0.35rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
		border: 2px solid var(--bg);
	}

	.period {
		font-size: 0.875rem;
		margin: 0 0 0.25rem 0;
	}

	.timeline h3 {
		font-size: 1.125rem;
		margin: 0 0 0.5rem 0;
	}

	.org {
		font-weight: 500;
		color: var(--text-muted);
	}

	.summary {
		margin: 0 0 0.5rem 0;
		color: var(--text-muted);
	}

	.timeline ul {
		margin: 0.5rem 0;
	}

	.timeline ul li {
		color: var(--text-muted);
		margin: 0.25rem 0;
	}

	.tag-row {
		margin-top: 0.75rem;
	}
</style>
