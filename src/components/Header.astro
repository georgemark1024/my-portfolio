---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/avatar.jpg';
---

<header>
	<nav aria-label="Main">
		<a class="site-title" href="/">
			<Image src={avatar} alt="" width={64} height={64} class="avatar" />
			{SITE_TITLE}
		</a>
		<button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
			<svg
				viewBox="0 0 24 24"
				aria-hidden="true"
				width="22"
				height="22"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<path class="icon-open" d="M4 6h16M4 12h16M4 18h16"></path>
				<path class="icon-close" d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
		<div class="internal-links" id="site-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 1rem 1.5rem;
		background: transparent;
		position: sticky;
		top: 0;
		z-index: 50;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
		position: relative;
	}

	/* Floating translucent pills over the scrolling content */
	.site-title,
	.internal-links,
	.menu-toggle {
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		border: 1px solid var(--border);
		border-radius: 999px;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.0625rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		padding: 0.3rem 1rem 0.3rem 0.3rem;
		white-space: nowrap;
	}

	.site-title :global(.avatar) {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--border);
	}

	.site-title:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		padding: 0.25rem 0.75rem;
	}

	nav .internal-links a {
		padding: 0.5em 0.75em;
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9375rem;
	}

	nav .internal-links a:hover {
		color: var(--accent);
	}

	nav .internal-links a.active {
		color: var(--accent);
		font-weight: 600;
	}

	.menu-toggle {
		display: none;
		color: var(--text);
		cursor: pointer;
		padding: 0.5rem;
		margin-left: auto;
	}

	.menu-toggle .icon-close {
		display: none;
	}

	.menu-toggle[aria-expanded='true'] .icon-open {
		display: none;
	}

	.menu-toggle[aria-expanded='true'] .icon-close {
		display: block;
	}

	@media (max-width: 720px) {
		.menu-toggle {
			display: inline-flex;
		}

		.internal-links {
			display: none;
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			padding: 0.5rem;
			border-radius: 16px;
			box-shadow: var(--shadow);
			z-index: 50;
		}

		.internal-links.open {
			display: flex;
		}

		nav .internal-links a {
			padding: 0.8em 1rem;
			border-radius: 10px;
			border-left: 3px solid transparent;
		}

		nav .internal-links a.active {
			border-left-color: var(--accent);
			background: var(--accent-subtle);
		}
	}
</style>

<script>
	const menuToggle = document.querySelector('.menu-toggle');
	const siteNav = document.getElementById('site-nav');
	menuToggle?.addEventListener('click', () => {
		const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!expanded));
		siteNav?.classList.toggle('open', !expanded);
	});
	// Close the menu when a link is chosen (matters for same-page #contact).
	siteNav?.addEventListener('click', (e) => {
		if (e.target instanceof HTMLAnchorElement) {
			menuToggle?.setAttribute('aria-expanded', 'false');
			siteNav.classList.remove('open');
		}
	});
</script>
